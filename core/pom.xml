<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ua.edu.sumdu</groupId>
    <artifactId>catalog-parent</artifactId>
    <version>2.0.0</version>
  </parent>
  <artifactId>core</artifactId>
  <name>Core</name>
  <packaging>jar</packaging>
  <dependencies>
    <!-- Specification API only: services declare transaction boundaries without Spring/Hibernate. -->
    <dependency>
      <groupId>jakarta.transaction</groupId>
      <artifactId>jakarta.transaction-api</artifactId>
    </dependency>
    <!-- Lab 9: Bean Validation API for RegisterUserDto (annotations only, no provider). -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <!-- Lab 9: BCrypt PasswordEncoder for UserService.register. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- Lab 9: UserDetailsService and @PreAuthorize; no servlet, MVC or JPA classes. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <!-- Lab 10: Mockito mocks of the repository ports in CommentServiceTest. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
